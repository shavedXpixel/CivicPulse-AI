{
  "name": "civicpulse-ai",
  "version": "1.0.0",
  "private": true,
  "description": "CivicPulse AI — Citizen Signals → Government Intelligence → Public Action",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm.cmd --prefix backend run dev",
    "dev:frontend": "npm.cmd --prefix frontend run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm.cmd run dev:backend\" \"npm.cmd run dev:frontend\"",
    "build:shared": "npm.cmd --prefix shared run build",
    "build:backend": "npm.cmd --prefix backend run build",
    "build:frontend": "npm.cmd --prefix frontend run build",
    "build": "npm.cmd run build:shared && npm.cmd run build:backend && npm.cmd run build:frontend",
    "test:shared": "npm.cmd --prefix shared run test",
    "test:backend": "npm.cmd --prefix backend run test",
    "test": "npm.cmd run test:shared && npm.cmd run test:backend",
    "lint:shared": "npm.cmd --prefix shared run lint",
    "lint:backend": "npm.cmd --prefix backend run lint",
    "lint:frontend": "npm.cmd --prefix frontend run lint",
    "lint": "npm.cmd run lint:shared && npm.cmd run lint:backend && npm.cmd run lint:frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
