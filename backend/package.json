{
  "name": "@civicpulse/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm --prefix ../shared run build && tsc -p tsconfig.json",
    "postinstall": "npm --prefix ../shared run build",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "data:import": "tsx scripts/data-import.ts",
    "data:validate": "tsx scripts/data-validate.ts",
    "data:verify": "tsx scripts/data-verify.ts",
    "test:live": "tsx scripts/verify-live-creds.ts",
    "test:real-live": "tsx scripts/live-real-mode-runner.ts",
    "demo:reset": "tsx scripts/demo-reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@civicpulse/shared": "*",
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "openai": "^7.17.0",
    "pg": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
