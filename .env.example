# ==============================================================================
# CivicPulse AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Demo & Provider Mode (use 'mock' for standalone offline development without cloud credentials)
PROVIDER_MODE=mock
DEMO_MODE=true

# Google Gemini / Vertex AI
# Required when PROVIDER_MODE=cloud
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
AI_MODEL_GENERAL=gemini-3.6-flash
AI_MODEL_EMBEDDING=text-embedding-004

# Firebase & Google Cloud
# Required when DEMO_MODE=false (REAL_MODE)
FIREBASE_PROJECT_ID=civicpulse-ai
# Path to service account JSON key file (keep in local root, NEVER commit to git)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# In production (Cloud Run/GCP), leave GOOGLE_APPLICATION_CREDENTIALS blank to use Application Default Credentials (ADC)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STORAGE_BUCKET=civicpulse-ai.appspot.com
BIGQUERY_DATASET=civicpulse_analytics

# Google Maps Platform (Browser API Key)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Logging & Monitoring
LOG_LEVEL=info

# Frontend Client Firebase Configuration (Required when NEXT_PUBLIC_DEMO_MODE=false)
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=civicpulse-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=civicpulse-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=civicpulse-ai.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=
