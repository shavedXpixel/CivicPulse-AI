# ==============================================================================
# CivicPulse AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production Runtime Mode
PROVIDER_MODE=cloud
DEMO_MODE=false

# Target Production Architecture — Active Providers
AUTH_PROVIDER=supabase
DATABASE_PROVIDER=postgres
STORAGE_PROVIDER=r2
AI_PROVIDER=gemini

# Google Gemini AI (Production Primary)
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
AI_MODEL_GENERAL=gemini-3.6-flash
AI_EMBEDDING_MODEL=gemini-embedding-001

# Map Tile Configuration (HTTPS raster tile template, e.g. OpenStreetMap)
NEXT_PUBLIC_MAP_TILE_URL=

# Logging & Monitoring
LOG_LEVEL=info

# ==============================================================================
# Target Production Architecture (Supabase + PostgreSQL + R2 + Gemini)
# ==============================================================================
# Supabase Authentication & PostgreSQL 17.6
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<key>
# Legacy alias for backward compatibility:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres.<your-project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Frontend Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# Canonical frontend publishable key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback (optional):
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 (S3-Compatible Object Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=civicpulse-media

# Production AI Engine (Google Gemini)
# GEMINI_API_KEY is configured above under Google Gemini section
# Primary & Fallback Models:
# GEMINI_PRIMARY_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Optional: Secondary / Standalone OpenAI Provider (Retained as non-default provider)
# OPENAI_API_KEY=
# AI_PROVIDER=openai (only when explicitly selected)

# ==============================================================================
# Email Delivery Configuration (Phase 15B.5.3.16A)
# ==============================================================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="CivicPulse Authority <notifications@civicpulse.gov.in>"

# ==============================================================================
# Legacy Rollback Stack (Firebase + Firestore + GCS + Gemini)
# ==============================================================================
# AUTH_PROVIDER=firebase
# DATABASE_PROVIDER=firestore
# STORAGE_PROVIDER=gcs
# AI_PROVIDER=gemini
# FIREBASE_PROJECT_ID=civicpulse-ai
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
