# ==============================================================================
# CivicPulse AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo & Provider Mode (use 'mock' for standalone offline development without cloud credentials)
PROVIDER_MODE=mock
DEMO_MODE=true

# Google Gemini / Vertex AI
# Required when PROVIDER_MODE=cloud
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
AI_MODEL_GENERAL=gemini-3.6-flash
AI_EMBEDDING_MODEL=text-embedding-004
# Legacy fallback: AI_MODEL_EMBEDDING=text-embedding-004

# Firebase & Google Cloud
# Required when DEMO_MODE=false (REAL_MODE)
FIREBASE_PROJECT_ID=civicpulse-ai
# Path to service account JSON key file (keep in local root, NEVER commit to git)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# In production (Cloud Run/GCP), leave GOOGLE_APPLICATION_CREDENTIALS blank to use Application Default Credentials (ADC)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STORAGE_BUCKET=civicpulse-ai.appspot.com
BIGQUERY_DATASET=civicpulse_analytics
FIREBASE_WEB_API_KEY=

# Google Maps Platform (Browser API Key)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Logging & Monitoring
LOG_LEVEL=info

# Frontend Client Firebase Configuration (Required when NEXT_PUBLIC_DEMO_MODE=false)
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=civicpulse-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=civicpulse-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=civicpulse-ai.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==============================================================================
# Target Production Architecture (Phase 15B / Render + Vercel Deployment)
# ==============================================================================
# Explicit Provider Selection (Target Production Stack)
AUTH_PROVIDER=supabase
DATABASE_PROVIDER=postgres
STORAGE_PROVIDER=r2
AI_PROVIDER=gemini

# Supabase Authentication & PostgreSQL 17.6
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<key>
# Legacy alias for backward compatibility:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres.<your-project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Frontend Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# Canonical frontend publishable key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback (optional):
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 (S3-Compatible Object Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=civicpulse-media

# Production AI Engine (Google Gemini)
# GEMINI_API_KEY is configured above under Google Gemini section
# Primary & Fallback Models:
# GEMINI_PRIMARY_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Optional: Secondary / Standalone OpenAI Provider (Retained as non-default provider)
# OPENAI_API_KEY=
# AI_PROVIDER=openai (only when explicitly selected)

# ==============================================================================
# Legacy Rollback Stack (Firebase + Firestore + GCS + Gemini)
# ==============================================================================
# AUTH_PROVIDER=firebase
# DATABASE_PROVIDER=firestore
# STORAGE_PROVIDER=gcs
# AI_PROVIDER=gemini
# FIREBASE_PROJECT_ID=civicpulse-ai
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json


